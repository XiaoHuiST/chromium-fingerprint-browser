+// 指纹注入: Canvas噪声添加
+void CanvasResourceProvider::AddCanvasNoise(SkBitmap* bitmap) {
+  content::FingerprintInjector* injector = content::FingerprintInjector::GetInstance();
+  if (!injector->IsInitialized()) {
+    return;
+  }
+  
+  std::string seed = injector->GetCanvasNoiseSeed();
+  if (seed.empty()) {
+    return;
+  }
+  
+  // 使用种子创建可重现的随机数生成器
+  std::hash<std::string> hasher;
+  std::mt19937 rng(static_cast<unsigned int>(hasher(seed)));
+  
+  // 获取像素数据
+  SkPixmap pixmap;
+  if (!bitmap->peekPixels(&pixmap)) {
+    return;
+  }
+  
+  uint8_t* pixels = static_cast<uint8_t*>(pixmap.writable_addr());
+  size_t size = pixmap.computeByteSize();
+  
+  // 添加微小噪声(每个像素±1-2)
+  for (size_t i = 0; i < size; i += 4) {
+    pixels[i] = static_cast<uint8_t>(pixels[i] + (rng() % 3) - 1);      // R
+    pixels[i+1] = static_cast<uint8_t>(pixels[i+1] + (rng() % 3) - 1);  // G
+    pixels[i+2] = static_cast<uint8_t>(pixels[i+2] + (rng() % 3) - 1);  // B
+    // Alpha通道不修改
+  }
+}
+
 scoped_refptr<StaticBitmapImage> CanvasResourceProvider::GetImage() {
   if (!IsValid())
     return nullptr;
@@ -167,6 +199,10 @@ scoped_refptr<StaticBitmapImage> CanvasResourceProvider::GetImage() {
     return nullptr;
   }
   
+  // 在返回图像前添加噪声
+  SkBitmap bitmap;
+  if (image->asLegacyBitmap(&bitmap)) {
+    AddCanvasNoise(&bitmap);
+    image = SkImages::RasterFromBitmap(bitmap);
+  }
+  
   return StaticBitmapImage::Create(std::move(image));
 }
 
