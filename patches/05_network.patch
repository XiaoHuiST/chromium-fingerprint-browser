@@ -5,6 +5,8 @@
 #include "third_party/blink/renderer/core/timing/time_clamper.h"
 
 #include "base/time/time.h"
+#include "content/browser/fingerprint_injector.h"
+#include <random>
 
 namespace blink {
 
@@ -23,6 +25,21 @@ double TimeClamper::ClampTimeResolution(double time_seconds) const {
   // 为了防止定时攻击,对时间精度进行限制
   // 通常精度限制在 5 微秒
   
+  // 指纹注入: 添加时间噪声
+  content::FingerprintInjector* injector = content::FingerprintInjector::GetInstance();
+  if (injector->IsInitialized()) {
+    std::string seed = injector->GetCanvasNoiseSeed();
+    if (!seed.empty()) {
+      std::hash<std::string> hasher;
+      std::mt19937 rng(static_cast<unsigned int>(hasher(seed) + static_cast<size_t>(time_seconds * 1000000)));
+      
+      // 添加微小的时间偏差(±50微秒)
+      double noise = (rng() % 100 - 50) / 1000000.0;
+      time_seconds += noise;
+    }
+  }
+  
   constexpr double kResolutionSeconds = 0.000005;  // 5微秒
   
   return floor(time_seconds / kResolutionSeconds) * kResolutionSeconds;
