 icu::TimeZone* GetDefaultTimeZone() {
+  // 指纹注入: 自定义时区
+  content::FingerprintInjector* injector = content::FingerprintInjector::GetInstance();
+  if (injector->IsInitialized()) {
+    std::string custom_tz = injector->GetTimezone();
+    if (!custom_tz.empty()) {
+      icu::UnicodeString tz_id = icu::UnicodeString::fromUTF8(custom_tz);
+      icu::TimeZone* timezone = icu::TimeZone::createTimeZone(tz_id);
+      if (timezone) {
+        return timezone;
+      }
+    }
+  }
+  
   return icu::TimeZone::createDefault();
 }
 
diff --git a/third_party/blink/renderer/core/timing/time_clamper.cc b/third_party/blink/renderer/core/timing/time_clamper.cc
