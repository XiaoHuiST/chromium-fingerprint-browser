diff --git a/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
index 1234567..abcdefg 100644
--- a/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
+++ b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
@@ -5,6 +5,7 @@
 #include "third_party/blink/renderer/core/frame/navigator_concurrent_hardware.h"
 
 #include "base/system/sys_info.h"
+#include "content/browser/fingerprint_injector.h"
 
 namespace blink {
 
@@ -12,7 +13,14 @@ unsigned NavigatorConcurrentHardware::hardwareConcurrency() const {
   // 返回CPU逻辑核心数
   // 原始实现: return base::SysInfo::NumberOfProcessors();
   
-  return base::SysInfo::NumberOfProcessors();
+  // 指纹注入: 从配置文件读取
+  content::FingerprintInjector* injector = content::FingerprintInjector::GetInstance();
+  if (injector->IsInitialized()) {
+    int threads = injector->GetCPUThreads();
+    if (threads > 0) {
+      return static_cast<unsigned>(threads);
+    }
+  }
+  
+  return base::SysInfo::NumberOfProcessors();
 }
 
