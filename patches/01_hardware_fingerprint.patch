 gfx::Size Screen::GetPrimaryDisplaySize() const {
+  // 指纹注入: 屏幕分辨率
+  content::FingerprintInjector* injector = content::FingerprintInjector::GetInstance();
+  if (injector->IsInitialized()) {
+    int width = injector->GetScreenWidth();
+    int height = injector->GetScreenHeight();
+    
+    if (width > 0 && height > 0) {
+      return gfx::Size(width, height);
+    }
+  }
+  
   const Display& display = GetPrimaryDisplay();
   return display.size();
 }
 
+int Screen::GetColorDepth() const {
+  content::FingerprintInjector* injector = content::FingerprintInjector::GetInstance();
+  if (injector->IsInitialized()) {
+    int depth = injector->GetColorDepth();
+    if (depth > 0) {
+      return depth;
+    }
+  }
+  return 24;  // 默认24位
+}
