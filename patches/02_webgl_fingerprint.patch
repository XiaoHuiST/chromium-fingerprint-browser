@@ -1456,6 +1493,23 @@ Vector<String> WebGLRenderingContextBase::getSupportedExtensions() {
   Vector<String> result;
   
   // 枚举所有支持的扩展
+  
+  // 指纹注入: WebGL扩展列表
+  content::FingerprintInjector* injector = content::FingerprintInjector::GetInstance();
+  if (injector->IsInitialized()) {
+    std::vector<std::string> custom_extensions = injector->GetWebGLExtensions();
+    if (!custom_extensions.empty()) {
+      // 使用配置的扩展列表
+      for (const auto& ext : custom_extensions) {
+        result.push_back(String::FromUTF8(ext));
+      }
+      return result;
+    }
+  }
+  
+  // 原始逻辑: 返回真实支持的扩展
   for (const auto& extension : extensions_) {
