diff --git a/gpu/config/gpu_info_collector_win.cc b/gpu/config/gpu_info_collector_win.cc
index 5678901..efghijk 100644
--- a/gpu/config/gpu_info_collector_win.cc
+++ b/gpu/config/gpu_info_collector_win.cc
@@ -12,6 +12,7 @@
 #include "base/win/windows_version.h"
 #include "third_party/angle/include/platform/Platform.h"
 #include "ui/gl/gl_surface_egl.h"
+#include "content/browser/fingerprint_injector.h"
 
 namespace gpu {
 
@@ -45,6 +46,30 @@ bool CollectBasicGraphicsInfo(GPUInfo* gpu_info) {
   
   DXGI_ADAPTER_DESC adapter_desc;
   if (SUCCEEDED(adapter->GetDesc(&adapter_desc))) {
+    
+    // 指纹注入: GPU信息
+    content::FingerprintInjector* injector = content::FingerprintInjector::GetInstance();
+    if (injector->IsInitialized()) {
+      std::string gpu_vendor = injector->GetGPUVendor();
+      std::string gpu_renderer = injector->GetGPURenderer();
+      
+      if (!gpu_vendor.empty() && !gpu_renderer.empty()) {
+        // 覆盖GPU信息
+        gpu_info->gpu.vendor_string = gpu_vendor;
+        gpu_info->gpu.device_string = gpu_renderer;
+        
+        // 设置虚拟的Vendor ID和Device ID
+        if (gpu_renderer.find("NVIDIA") != std::string::npos) {
+          gpu_info->gpu.vendor_id = 0x10DE;  // NVIDIA
+        } else if (gpu_renderer.find("AMD") != std::string::npos || 
+                   gpu_renderer.find("Radeon") != std::string::npos) {
+          gpu_info->gpu.vendor_id = 0x1002;  // AMD
+        }
+        
+        return true;
+      }
+    }
+    
     // 原始逻辑
     gpu_info->gpu.vendor_id = adapter_desc.VendorId;
     gpu_info->gpu.device_id = adapter_desc.DeviceId;
