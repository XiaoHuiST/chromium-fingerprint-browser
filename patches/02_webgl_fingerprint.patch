     case GL_VERSION:
       return WebGLAny(script_state, "WebGL 1.0");
       
+    // 指纹注入: WebGL Vendor
+    case GLenum(WebGLDebugRendererInfo::kUnmaskedVendorWebgl): {
+      content::FingerprintInjector* injector = content::FingerprintInjector::GetInstance();
